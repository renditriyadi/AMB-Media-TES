{
  "manifest_version": 3,
  "name": "Dola Video Grabber & Downloader (No Watermark)",
  "version": "1.0.0",
  "description": "Ekstensi split screen panel samping untuk mendeteksi & download video Dola AI langsung dari CDN tanpa watermark (1080p).",
  "permissions": [
    "sidePanel",
    "downloads",
    "storage",
    "tabs",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.dola.com/*",
    "https://*.dola.com/*",
    "http://*.dola.com/*",
    "https://*.byteintlapi.com/*",
    "https://*.ibyteimg.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Buka Dola Downloader Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.dola.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.dola.com/*"],
      "js": ["inject_network.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject_network.js", "icons/*"],
      "matches": ["https://www.dola.com/*"]
    }
  ]
}
